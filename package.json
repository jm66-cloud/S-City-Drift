{
  "name": "shen-hai-piao",
  "version": "0.0.1",
  "description": "一座海岛，一个机会 — 俯视角2D海岛城市生活模拟游戏",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "start vite && start electron .",
    "electron:build": "vite build && electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jm66-cloud/S-City-Drift.git"
  },
  "keywords": [
    "phaser",
    "electron",
    "city-sim",
    "stock-trading"
  ],
  "author": "Shen Hai Piao Contributors",
  "license": "MIT",
  "dependencies": {
    "phaser": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "build": {
    "appId": "com.shenhaipiao.game",
    "productName": "申海漂",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "sounds/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
