enum PaletteKey {
	BLACK, DARK_GRAY, MID_GRAY, LIGHT_GRAY, WHITE,
	DARK_RED, RED, ORANGE, LIGHT_ORANGE, SKIN,
	YELLOW, GOLD,
	DARK_GREEN, FOREST, GREEN, LIGHT_GREEN, PALE_GREEN,
	DARK_TEAL, TEAL, CYAN,
	DARK_BLUE, BLUE, MID_BLUE, LIGHT_BLUE, SKY_BLUE, PALE_BLUE,
	PURPLE, LAVENDER,
	DARK_BROWN, BROWN, TAN, LIGHT_TAN, PALE_TAN,
}

const ALL_COLORS: Array[Color] = [
	Color8(0x00, 0x00, 0x00), Color8(0x52, 0x52, 0x52), Color8(0x9D, 0x9D, 0x9D), Color8(0xD2, 0xD2, 0xD2), Color8(0xFF, 0xFF, 0xFF),
	Color8(0x00, 0x2B, 0x2B), Color8(0xEA, 0x3C, 0x3C), Color8(0xFF, 0x8C, 0x00), Color8(0xFF, 0xB0, 0x3C), Color8(0xFF, 0xD4, 0x9C),
	Color8(0xFD, 0xFC, 0x74), Color8(0xD4, 0xA0, 0x28),
	Color8(0x00, 0x4C, 0x2A), Color8(0x00, 0x7B, 0x3E), Color8(0x36, 0xA8, 0x3E), Color8(0x6D, 0xD3, 0x62), Color8(0xB5, 0xE6, 0x9D),
	Color8(0x00, 0x4C, 0x4C), Color8(0x00, 0x7B, 0x7B), Color8(0x00, 0xC8, 0xC8),
	Color8(0x00, 0x2B, 0x5C), Color8(0x00, 0x5C, 0x9E), Color8(0x3C, 0x8D, 0xC8), Color8(0x74, 0xBA, 0xD4), Color8(0x9D, 0xD3, 0xD3), Color8(0xC8, 0xE6, 0xE6),
	Color8(0x6B, 0x3C, 0x8D), Color8(0xA8, 0x6E, 0xC8),
	Color8(0x3C, 0x2B, 0x1E), Color8(0x6B, 0x4C, 0x2A), Color8(0xA8, 0x7C, 0x4A), Color8(0xD4, 0xA8, 0x6E), Color8(0xE6, 0xC8, 0xA8),
]

static func get(key: PaletteKey) -> Color:
	return ALL_COLORS[key]

static func random() -> Color:
	return ALL_COLORS[randi() % ALL_COLORS.size()]

static func random_from(keys: Array[PaletteKey]) -> Color:
	return ALL_COLORS[keys[randi() % keys.size()]]

# 生成一个纯色 Image（用于调试/占位）
static func create_placeholder_image(width: int, height: int, color: Color) -> Image:
	var img := Image.create(width, height, false, Image.FORMAT_RGBA8)
	img.fill(color)
	return img
